/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 도색명
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_cargo_subtype_text, cargo_subtype) {
    0: return string(STR_REFIT_LIVERY_DTS_CityLink_120_engine_A);
    1: return string(STR_REFIT_LIVERY_DTS_CityLink_120_engine_B);
}

// 도색그래픽 세팅
// 열차
// 후진방향
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_engineH, train_is_driving_backwards) {
    0: set_DTS_CityLink_120_Pass_engineH;
    1: set_DTS_CityLink_120_Pass_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_engineT, train_is_driving_backwards) {
    0: set_DTS_CityLink_120_Pass_engineT;
    1: set_DTS_CityLink_120_Pass_engineT_A_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_panto_wagon_M1, train_is_driving_backwards) {
    0: set_DTS_CityLink_120_Pass_panto_down_wagon_M1;
    1: set_DTS_CityLink_120_Pass_panto_up_wagon_M1;
}

switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_panto_wagon_M1_Rev, train_is_driving_backwards) {
    0: set_DTS_CityLink_120_Pass_panto_up_wagon_M1_Rev;
    1: set_DTS_CityLink_120_Pass_panto_down_wagon_M1_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DTS_CityLink_120_Pass_engineT;
    sw_DTS_CityLink_120_Pass_engineH;
}

// 객차
// Pantograph - less than 7 cars (TC1 - T'1 (- M - ... - M -) T'2 - TC2)
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_wagon_for_short_front, position_in_vehid_chain) {
    0: sw_DTS_CityLink_120_Pass_panto_wagon_M1;
    set_DTS_CityLink_120_Pass_wagon_M2;
}
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_wagon, position_in_vehid_chain_from_end) {
    0: sw_DTS_CityLink_120_Pass_panto_wagon_M1_Rev;
    sw_DTS_CityLink_120_Pass_wagon_for_short_front;
}