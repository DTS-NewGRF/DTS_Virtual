/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 도색명
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_cargo_subtype_text, cargo_subtype) {
    0: return string(STR_REFIT_LIVERY_DTS_CityLink_120_engine_A);
    1: return string(STR_REFIT_LIVERY_DTS_CityLink_120_engine_B);
}

// 도색그래픽 세팅
// 열차
// 후진방향
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_engineT_Back, cargo_subtype) {
    0: set_DTS_CityLink_120_Pass_engineT_A_Rev;
    1: set_DTS_CityLink_120_Pass_engineT_B_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_engineH, train_is_driving_backwards) {
    0: set_DTS_CityLink_120_Pass_engineH;
    1: set_DTS_CityLink_120_Pass_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_engineT, train_is_driving_backwards) {
    0: set_DTS_CityLink_120_Pass_engineT;
    1: sw_DTS_CityLink_120_Pass_engineT_Back;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    0: sw_DTS_CityLink_120_Pass_engineH;
    1: sw_DTS_CityLink_120_Pass_engineT;
}

switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_panto_wagon_M1_Bachwords, train_is_driving_backwards) {
    0: set_DTS_CityLink_120_Pass_panto_wagon_M1;
    1: set_DTS_CityLink_120_Pass_panto_wagon_M1_Rev;
}

// 객차
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_panto_wagon_M1, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    0: sw_DTS_CityLink_120_Pass_panto_wagon_M1_Bachwords;
}

switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_wagon_M23, (position_in_vehid_chain + 1) <= (num_vehs_in_vehid_chain / 2)) {
    0: set_DTS_CityLink_120_Pass_wagon_M3;
    1: set_DTS_CityLink_120_Pass_wagon_M2;
}
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_wagon_rear, [STORE_TEMP(1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]){
    0: sw_DTS_CityLink_120_Pass_wagon_M23;
    1: sw_DTS_CityLink_120_Pass_panto_wagon_M1;
    
}
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_120_Pass_wagon, [STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
    0: sw_DTS_CityLink_120_Pass_wagon_rear;
    1: sw_DTS_CityLink_120_Pass_wagon_M23;
}