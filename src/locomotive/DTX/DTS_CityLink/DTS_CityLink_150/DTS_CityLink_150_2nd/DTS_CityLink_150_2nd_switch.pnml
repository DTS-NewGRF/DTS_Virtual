    2: sw_DTS_CityLink_150_2nd_wagon_M1;
    3..4: sw_DTS_CityLink_150_2nd_wagon_T;
    5: sw_DTS_CityLink_150_2nd_wagon_M2;
    6: sw_DTS_CityLink_150_2nd_panto_wagon_M2;
    7: sw_DTS_CityLink_150_2nd_engineT;
    }

// 10량
switch (FEAT_TRAINS, SELF, sw_DTS_CityLink_150_2nd_10car, position_in_vehid_chain % 10) {
