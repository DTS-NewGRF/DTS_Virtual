    2: sw_DTS_CityLink_150_2nd_panto_wagon_M1;
    3: sw_DTS_CityLink_150_2nd_wagon_M1;
    4..5: sw_DTS_CityLink_150_2nd_wagon_T;
    6: sw_DTS_CityLink_150_2nd_wagon_M2;
    7: sw_DTS_CityLink_150_2nd_panto_wagon_M2;
    8: sw_DTS_CityLink_150_2nd_wagon_M2;
    9: sw_DTS_CityLink_150_2nd_engineT;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_DTS_CityLink_150_2nd_4car, extra_callback_info1) {
    1..3: DTS_CityLink_150_2nd_4Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

