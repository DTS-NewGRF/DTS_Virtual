}

// 편성그래픽
// 4량
switch (FEAT_TRAINS, SELF, sw_DTS_CityLink_150_2nd_4car, position_in_vehid_chain % 4) {
    0: sw_DTS_CityLink_150_2nd_engineH; //default
    1: sw_DTS_CityLink_150_2nd_panto_wagon_M1;
    2: sw_DTS_CityLink_150_2nd_panto_wagon_M2;
    3: sw_DTS_CityLink_150_2nd_engineT;
    }

