switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_150_2nd_speed, cargo_subtype) {
    0: sw_Regular_150_speed;
    1: sw_High_180_speed;
    2: sw_Regular_150_speed;
    3: sw_High_180_speed;
