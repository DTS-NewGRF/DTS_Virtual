// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_DFX_10car, position_in_vehid_chain % 10) {
    0: set_DFX_engineH; //default
    1..8: set_DFX_wagon;
    9: set_DFX_engineT;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_DFX_10car, extra_callback_info1) {
    1..9: DFX_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }