/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_ITX_CheongChan_engineH, train_is_driving_backwards) {
    0: set_ITX_CheongChan_engineH;
    1: set_ITX_CheongChan_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_ITX_CheongChan_panto_wagon_M1, train_is_driving_backwards) {
    0: set_ITX_CheongChan_panto_wagon_M1;
    1: set_ITX_CheongChan_panto_wagon_M1_Rev;
}

switch(FEAT_TRAINS, SELF, sw_ITX_CheongChan_panto_wagon_M2, train_is_driving_backwards) {
    0: set_ITX_CheongChan_panto_wagon_M2;
    1: set_ITX_CheongChan_panto_wagon_M2_Rev;
}

switch(FEAT_TRAINS, SELF, sw_ITX_CheongChan_engineT, train_is_driving_backwards) {
    0: set_ITX_CheongChan_engineT;
    1: set_ITX_CheongChan_engineT_Rev;
}

// 편성그래픽
// 6량
switch (FEAT_TRAINS, SELF, sw_ITX_CheongChan_6car, position_in_vehid_chain % 6) {
    0: sw_ITX_CheongChan_engineH; //default
    1: sw_ITX_CheongChan_panto_wagon_M1;
    2: set_ITX_CheongChan_wagon_M1;
    3: set_ITX_CheongChan_wagon_T;
    4: sw_ITX_CheongChan_panto_wagon_M2;
    5: sw_ITX_CheongChan_engineT;
    }

// 8량
switch (FEAT_TRAINS, SELF, sw_ITX_CheongChan_8car, position_in_vehid_chain % 8) {
    0: sw_ITX_CheongChan_engineH; //default
    1: sw_ITX_CheongChan_panto_wagon_M1;
    2: set_ITX_CheongChan_wagon_M1;
    3: set_ITX_CheongChan_wagon_T;
    4: set_ITX_CheongChan_wagon_T;
    5: set_ITX_CheongChan_wagon_M2;
    6: sw_ITX_CheongChan_panto_wagon_M2;
    7: sw_ITX_CheongChan_engineT;
    }

// 10량
switch (FEAT_TRAINS, SELF, sw_ITX_CheongChan_10car, position_in_vehid_chain % 10) {
    0: sw_ITX_CheongChan_engineH; //default
    1: set_ITX_CheongChan_wagon_M1;
    2: sw_ITX_CheongChan_panto_wagon_M1;
    3: set_ITX_CheongChan_wagon_M1;
    4: set_ITX_CheongChan_wagon_T;
    5: set_ITX_CheongChan_wagon_T;
    6: set_ITX_CheongChan_wagon_M2;
    7: sw_ITX_CheongChan_panto_wagon_M2;
    8: set_ITX_CheongChan_wagon_M2;
    9: sw_ITX_CheongChan_engineT;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_ITX_CheongChan_6car, extra_callback_info1) {
    1..5: ITX_CheongChan_6Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_ITX_CheongChan_8car, extra_callback_info1) {
    1..7: ITX_CheongChan_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_ITX_CheongChan_10car, extra_callback_info1) {
    1..9: ITX_CheongChan_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }