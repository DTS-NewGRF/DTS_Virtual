/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_ITX_CheongChun_DD_engineH, train_is_driving_backwards) {
    0: set_ITX_CheongChun_DD_engineH;
    1: set_ITX_CheongChun_DD_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_ITX_CheongChun_DD_engineT, train_is_driving_backwards) {
    0: set_ITX_CheongChun_DD_engineT;
    1: set_ITX_CheongChun_DD_engineT_Rev;
}

// 편성그래픽
// 8량
switch (FEAT_TRAINS, SELF, sw_ITX_CheongChun_DD_8car, position_in_vehid_chain % 8) {
    0: sw_ITX_CheongChun_DD_engineH; //default
    1: set_ITX_CheongChun_DD_wagon_M1;
    2: set_ITX_CheongChun_DD_wagon_M2;
    3: set_ITX_CheongChun_DD_wagon_M1;
    4: set_ITX_CheongChun_DD_wagon_M2;
    5: set_ITX_CheongChun_DD_wagon_M1;
    6: set_ITX_CheongChun_DD_wagon_M2;
    7: sw_ITX_CheongChun_DD_engineT;
    }

// 10량
switch (FEAT_TRAINS, SELF, sw_ITX_CheongChun_DD_10car, position_in_vehid_chain % 10) {
    0: sw_ITX_CheongChun_DD_engineH; //default
    1: set_ITX_CheongChun_DD_wagon_M1;
    2: set_ITX_CheongChun_DD_wagon_M2;
    3: set_ITX_CheongChun_DD_wagon_M1;
    4: set_ITX_CheongChun_DD_wagon_M2;
    5: set_ITX_CheongChun_DD_wagon_M1;
    6: set_ITX_CheongChun_DD_wagon_M2;
    7: set_ITX_CheongChun_DD_wagon_M1;
    8: set_ITX_CheongChun_DD_wagon_M2;
    9: sw_ITX_CheongChun_DD_engineT;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_sw_ITX_CheongChun_DD_8car, extra_callback_info1) {
    1..7: ITX_CheongChun_DD_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_sw_ITX_CheongChun_DD_10car, extra_callback_info1) {
    1..9: ITX_CheongChun_DD_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }