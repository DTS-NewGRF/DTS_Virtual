/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_ITX_Maum_engineH, train_is_driving_backwards) {
    0: set_ITX_Maum_engineH;
    1: set_ITX_Maum_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_ITX_Maum_panto_wagon_M1, train_is_driving_backwards) {
    0: set_ITX_Maum_panto_wagon_M1;
    1: set_ITX_Maum_panto_wagon_M1_Rev;
}

switch(FEAT_TRAINS, SELF, sw_ITX_Maum_panto_wagon_6Car_M2, train_is_driving_backwards) {
    0: set_ITX_Maum_panto_wagon_6Car_M2;
    1: set_ITX_Maum_panto_wagon_6Car_M2_Rev;
}

switch(FEAT_TRAINS, SELF, sw_ITX_Maum_engineT, train_is_driving_backwards) {
    0: set_ITX_Maum_engineT;
    1: set_ITX_Maum_engineT_Rev;
}

// 편성그래픽
// 8량
switch (FEAT_TRAINS, SELF, sw_ITX_Maum_8car, position_in_vehid_chain % 8) {
    0: sw_ITX_Maum_engineH; //default
    1: sw_ITX_Maum_panto_wagon_M1;
    2: set_ITX_Maum_wagon_M;
    3: set_ITX_Maum_wagon_DUP1;
    4: set_ITX_Maum_wagon_DUP2;
    5: set_ITX_Maum_wagon_T;
    6: sw_ITX_Maum_panto_wagon_6Car_M2;
    7: sw_ITX_Maum_engineT;
    }

// 10량
switch (FEAT_TRAINS, SELF, sw_ITX_Maum_10car, position_in_vehid_chain % 10) {
    0: sw_ITX_Maum_engineH; //default
    1: sw_ITX_Maum_panto_wagon_M1;
    2: set_ITX_Maum_wagon_M;
    3: set_ITX_Maum_wagon_DUP1;
    4: set_ITX_Maum_wagon_DUP2;
    5: set_ITX_Maum_wagon_DUP1;
    6: set_ITX_Maum_wagon_DUP2;
    7: set_ITX_Maum_wagon_T;
    8: sw_ITX_Maum_panto_wagon_6Car_M2;
    9: sw_ITX_Maum_engineT;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_ITX_Maum_8car, extra_callback_info1) {
    1..7: ITX_Maum_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_ITX_Maum_10car, extra_callback_info1) {
    1..9: ITX_Maum_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }