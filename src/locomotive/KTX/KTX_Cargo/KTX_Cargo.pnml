item(FEAT_TRAINS, KTX_Cargo, 1145){
    property {
        name:                           string(STR_KTX_Cargo_NAME);
        climates_available:             NO_CLIMATE;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        power:                          9600 kW;
        variant_group:                  KTX_Logo;
        }

    graphics {
        purchase:                       set_KTX_Cargo_purchase;
        }
        }

