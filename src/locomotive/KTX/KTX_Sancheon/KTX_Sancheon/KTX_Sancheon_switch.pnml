    0: set_KTX_Honam_Sky_blue_wagon_T2;
    1: set_KTX_Honam_Yellow_wagon_T2;
    2: set_KTX_Gyeonggang_Blue_wagon_T2;
    3: set_KTX_Gyeonggang_White_wagon_T2;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_wagon_T3, cargo_subtype) {
    0: set_KTX_Honam_Sky_blue_wagon_T3;
    1: set_KTX_Honam_Yellow_wagon_T3;
    2: set_KTX_Gyeonggang_Blue_wagon_T3;
    3: set_KTX_Gyeonggang_White_wagon_T3;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_wagon_T4, cargo_subtype) {
    0: set_KTX_Honam_Sky_blue_wagon_T4;
    1: set_KTX_Honam_Yellow_wagon_T4;
    2: set_KTX_Gyeonggang_Blue_wagon_T4;
    3: set_KTX_Gyeonggang_White_wagon_T4;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_wagon_T5, cargo_subtype) {
    0: set_KTX_Honam_Sky_blue_wagon_T5;
    1: set_KTX_Honam_Yellow_wagon_T5;
    2: set_KTX_Gyeonggang_Blue_wagon_T5;
    3: set_KTX_Gyeonggang_White_wagon_T5;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_wagon_T6, cargo_subtype) {
    0: set_KTX_Honam_Sky_blue_wagon_T6;
    1: set_KTX_Honam_Yellow_wagon_T6;
    2: set_KTX_Gyeonggang_Blue_wagon_T6;
    3: set_KTX_Gyeonggang_White_wagon_T6;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_engineT_Front, cargo_subtype) {
    0: set_KTX_Honam_Sky_blue_engineT;
    1: set_KTX_Honam_Yellow_engineT;
    2: set_KTX_Gyeonggang_Blue_engineT;
    3: set_KTX_Gyeonggang_White_engineT;
}

// 후진방향
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_engineH_Back, cargo_subtype) {
    0: set_KTX_Honam_Sky_blue_engineH_Rev;
    1: set_KTX_Honam_Yellow_engineH_Rev;
    2: set_KTX_Gyeonggang_Blue_engineH_Rev;
    3: set_KTX_Gyeonggang_White_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_engineT_Back, cargo_subtype) {
    0: set_KTX_Honam_Sky_blue_engineT_Rev;
    1: set_KTX_Honam_Yellow_engineT_Rev;
    2: set_KTX_Gyeonggang_Blue_engineT_Rev;
    3: set_KTX_Gyeonggang_White_engineT_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_engineH, train_is_driving_backwards) {
    0: sw_KTX_Sancheon_engineH_Front;
    1: sw_KTX_Sancheon_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_engineT, train_is_driving_backwards) {
    0: sw_KTX_Sancheon_engineT_Front;
    1: sw_KTX_Sancheon_engineT_Back;
}

// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_10car, position_in_vehid_chain % 10) {
    0: sw_KTX_Sancheon_engineH; //default
    1: sw_KTX_Sancheon_wagon_T1;
    2: sw_KTX_Sancheon_wagon_T2;
    3: sw_KTX_Sancheon_wagon_T3;
    4: sw_KTX_Sancheon_wagon_T4;
    5: sw_KTX_Sancheon_wagon_T5;
    6: sw_KTX_Sancheon_wagon_T5;
    7: sw_KTX_Sancheon_wagon_T4;
    8: sw_KTX_Sancheon_wagon_T6;
    9: sw_KTX_Sancheon_engineT;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Sancheon_10car, extra_callback_info1) {
    1..9: KTX_Sancheon_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

// 객차 길이
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_wagon_length_in_custom, position_in_vehid_chain % 10) {
    0..1: 8; //default;
    2..7: 7;
    8..9: 8;
}

// 수송량
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_capacity_in_custom, cargo_subtype) {
    0..3: 38;
    4..6: return 41;
}