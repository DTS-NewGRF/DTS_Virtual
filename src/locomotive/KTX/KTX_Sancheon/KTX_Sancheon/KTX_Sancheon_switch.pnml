// 도색명
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_cargo_subtype_text, cargo_subtype) {
    0: return string(STR_REFIT_LIVERY_KTX_Honam_Sky_blue);
    1: return string(STR_REFIT_LIVERY_KTX_Honam_Yellow);
    2: return string(STR_REFIT_LIVERY_KTX_Gyeonggang_Blue);
    3: return string(STR_REFIT_LIVERY_KTX_Gyeonggang_White);
}

// 도색그래픽 세팅
// 열차
// 전진방향
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_engineH_Front, cargo_subtype) {
    0: set_KTX_Honam_Sky_blue_engineH;
    1: set_KTX_Honam_Yellow_engineH;
    2: set_KTX_Gyeonggang_Blue_engineH;
    3: set_KTX_Gyeonggang_White_engineH;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_wagon_T1, cargo_subtype) {
    0: set_KTX_Honam_Sky_blue_wagon_T1;
    1: set_KTX_Honam_Yellow_wagon_T1;
    2: set_KTX_Gyeonggang_Blue_wagon_T1;
    3: set_KTX_Gyeonggang_White_wagon_T1;
}

