     1: set_KTX_Cheong_Ryong_THSR_wagon_M2_r;
     2: set_KTX_Cheong_Ryong_THSR_wagon_M4_r;
     3..5: set_KTX_Cheong_Ryong_THSR_wagon_M3_r;
     6..8: set_KTX_Cheong_Ryong_THSR_wagon_M2_r;
     9: set_KTX_Cheong_Ryong_THSR_wagon_M1_r;
    10: set_KTX_Cheong_Ryong_THSR_wagon_M2_r;
    11: set_KTX_Cheong_Ryong_THSR_engineH_r;
    }

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_12car_flipped, vehicle_is_flipped){
    0: sw_KTX_Cheong_Ryong_12car_r;
    sw_KTX_Cheong_Ryong_12car;
}

switch(FEAT_TRAINS, PARENT, sw_KTX_Cheong_Ryong_12car_reversed, vehicle_is_reversed){
    0: sw_KTX_Cheong_Ryong_12car;
    sw_KTX_Cheong_Ryong_12car_flipped;
}

// 16량
switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_16car, position_in_vehid_chain % 16) {
     0: sw_KTX_Cheong_Ryong_16Car_engineH;
     1..3: sw_KTX_Cheong_Ryong_16Car_wagon_M2;
     4:sw_KTX_Cheong_Ryong_16Car_wagon_M1;
     5:sw_KTX_Cheong_Ryong_16Car_wagon_M2;
     6:sw_KTX_Cheong_Ryong_16Car_wagon_M3;
     7..10: sw_KTX_Cheong_Ryong_16Car_wagon_M2;
    11:sw_KTX_Cheong_Ryong_16Car_wagon_M4;
    12..14:sw_KTX_Cheong_Ryong_16Car_wagon_M2;
    15:sw_KTX_Cheong_Ryong_16Car_engineT;
    }

switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_16car_r, position_in_vehid_chain % 16) {
     0: sw_KTX_Cheong_Ryong_16Car_engineT_r;
     1..3:sw_KTX_Cheong_Ryong_16Car_wagon_M2_r;
     4:sw_KTX_Cheong_Ryong_16Car_wagon_M4_r;
     5..8:sw_KTX_Cheong_Ryong_16Car_wagon_M2_r;
     9:sw_KTX_Cheong_Ryong_16Car_wagon_M3_r;
    10:sw_KTX_Cheong_Ryong_16Car_wagon_M2_r;
    11:sw_KTX_Cheong_Ryong_16Car_wagon_M1_r;
    12..14:sw_KTX_Cheong_Ryong_16Car_wagon_M2_r;
    15:sw_KTX_Cheong_Ryong_16Car_engineH_r;
    }

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_16car_flipped, vehicle_is_flipped){
    0: sw_KTX_Cheong_Ryong_16car_r;
    sw_KTX_Cheong_Ryong_16car;
}

switch(FEAT_TRAINS, PARENT, sw_KTX_Cheong_Ryong_16car_reversed, vehicle_is_reversed){
    0: sw_KTX_Cheong_Ryong_16car;
    sw_KTX_Cheong_Ryong_16car_flipped;
}

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Cheong_Ryong_8car, extra_callback_info1) {
    1..7: KTX_Cheong_Ryong_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Cheong_Ryong_12car, extra_callback_info1) {
    1..11: KTX_Cheong_Ryong_12Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Cheong_Ryong_16car, extra_callback_info1) {
    1..15: KTX_Cheong_Ryong_16Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }