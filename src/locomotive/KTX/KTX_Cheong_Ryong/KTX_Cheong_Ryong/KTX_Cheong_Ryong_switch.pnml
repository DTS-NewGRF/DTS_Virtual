    2:sw_KTX_Cheong_Ryong_wagon_M2_6Car_r;
    3:sw_KTX_Cheong_Ryong_wagon_M2_5Car_r;
    4:sw_KTX_Cheong_Ryong_wagon_M3_r;
    5:sw_KTX_Cheong_Ryong_wagon_M2_3Car_r;
    6:sw_KTX_Cheong_Ryong_wagon_M1_r;
    7:sw_KTX_Cheong_Ryong_engineH_r;
    sw_KTX_Cheong_Ryong_engineT_r; //default
    }

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_8car_flipped, vehicle_is_flipped){
    0: sw_KTX_Cheong_Ryong_8car_r;
    sw_KTX_Cheong_Ryong_8car;
}

switch(FEAT_TRAINS, PARENT, sw_KTX_Cheong_Ryong_8car_reversed, vehicle_is_reversed){
    0: sw_KTX_Cheong_Ryong_8car;
    sw_KTX_Cheong_Ryong_8car_flipped;
}

