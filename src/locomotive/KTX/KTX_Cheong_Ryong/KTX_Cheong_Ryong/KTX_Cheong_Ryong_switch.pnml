//도색명
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_cargo_subtype_text, cargo_subtype) {
     0: return string(STR_REFIT_LIVERY_KTX_Cheong_Ryong_BK);
     1: return string(STR_REFIT_LIVERY_KTX_Cheong_Ryong_CC);
     2: return string(STR_REFIT_LIVERY_KTX_Cheong_Ryong_Euro);
     3: return string(STR_REFIT_LIVERY_KTX_Cheong_Ryong_ICE);
     4: return string(STR_REFIT_LIVERY_KTX_Cheong_Ryong_JR);
     5: return string(STR_REFIT_LIVERY_KTX_Cheong_Ryong_SRT_A);
     6: return string(STR_REFIT_LIVERY_KTX_Cheong_Ryong_SRT_B);
     7: return string(STR_REFIT_LIVERY_KTX_Cheong_Ryong_SRT_C);
     8: return string(STR_REFIT_LIVERY_KTX_Cheong_Ryong_SRT_D);
     9: return string(STR_REFIT_LIVERY_KTX_Cheong_Ryong_SRT_E);
    10: return string(STR_REFIT_LIVERY_KTX_Cheong_Ryong_THRS);
}

