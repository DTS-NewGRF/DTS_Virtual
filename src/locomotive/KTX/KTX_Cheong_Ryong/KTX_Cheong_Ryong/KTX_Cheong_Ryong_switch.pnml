// 8량
switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_8car, position_in_vehid_chain % 8) {
    1:sw_KTX_Cheong_Ryong_wagon_M1;
    2:sw_KTX_Cheong_Ryong_wagon_M2_3car;
    3:sw_KTX_Cheong_Ryong_wagon_M3;
    4:sw_KTX_Cheong_Ryong_wagon_M2_5car;
    5:sw_KTX_Cheong_Ryong_wagon_M2_6car;
    6:sw_KTX_Cheong_Ryong_wagon_M4;
    7:sw_KTX_Cheong_Ryong_engineT;
    sw_KTX_Cheong_Ryong_engineH; //default
    }

