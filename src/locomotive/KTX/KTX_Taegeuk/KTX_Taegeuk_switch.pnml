// 편성그래픽
// 8량
switch (FEAT_TRAINS, SELF, sw_KTX_Taegeuk_8car, position_in_vehid_chain % 8) {
    1:set_KTX_Taegeuk_wagon_T2;
    2:set_KTX_Taegeuk_wagon_T3;
    3:set_KTX_Taegeuk_wagon_T4;
    4:set_KTX_Taegeuk_wagon_T5;
    5:set_KTX_Taegeuk_wagon_T6;
    6:set_KTX_Taegeuk_wagon_T7;
    7:set_KTX_Taegeuk_engineT;
    set_KTX_Taegeuk_engineH; //default
    }

switch (FEAT_TRAINS, SELF, sw_KTX_Taegeuk_8car_r, position_in_vehid_chain % 8) {
    1:set_KTX_Taegeuk_wagon_T7_r;
    2:set_KTX_Taegeuk_wagon_T6_r;
    3:set_KTX_Taegeuk_wagon_T5_r;
    4:set_KTX_Taegeuk_wagon_T4_r;
    5:set_KTX_Taegeuk_wagon_T3_r;
    6:set_KTX_Taegeuk_wagon_T2_r;
    7:set_KTX_Taegeuk_engineH_r;
    set_KTX_Taegeuk_engineT_r; //default
    }

switch(FEAT_TRAINS, SELF, sw_KTX_Taegeuk_8car_flipped, vehicle_is_flipped){
    0: sw_KTX_Taegeuk_8car_r;
    sw_KTX_Taegeuk_8car;
}

switch(FEAT_TRAINS, PARENT, sw_KTX_Taegeuk_8car_reversed, vehicle_is_reversed){
    0: sw_KTX_Taegeuk_8car;
    sw_KTX_Taegeuk_8car_flipped;
}

