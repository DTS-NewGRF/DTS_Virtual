/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 도색명
switch(FEAT_TRAINS, SELF, sw_Nuriro_DD_cargo_subtype_text, cargo_subtype) {
    0: return string(STR_REFIT_LIVERY_Nuriro_DD_Old);
    1: return string(STR_REFIT_LIVERY_Nuriro_DD_New);
    2: return string(STR_REFIT_LIVERY_Nuriro_DD_O_Train);
    3: return string(STR_REFIT_LIVERY_Nuriro_DD_ITX_Saemaeul);
}

// 도색그래픽 세팅
// 열차
// 전진방향
switch(FEAT_TRAINS, SELF, sw_Nuriro_DD_engineH_Front, cargo_subtype) {
    0: set_Nuriro_DD_Old_engineH;
    1: set_Nuriro_DD_New_engineH;
    2: set_Nuriro_DD_O_Train_engineH;
    3: set_Nuriro_DD_ITX_Saemaeul_engineH;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_DD_wagon_T1, cargo_subtype) {
    0: set_Nuriro_DD_Old_wagon_T1;
    1: set_Nuriro_DD_New_wagon_T1;
    2: set_Nuriro_DD_O_Train_wagon_T1;
    3: set_Nuriro_DD_ITX_Saemaeul_wagon_T1;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_DD_wagon_M, cargo_subtype) {
    0: set_Nuriro_DD_Old_wagon_M;
    1: set_Nuriro_DD_New_wagon_M;
    2: set_Nuriro_DD_O_Train_wagon_M;
    3: set_Nuriro_DD_ITX_Saemaeul_wagon_M;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_DD_wagon_T2, cargo_subtype) {
    0: set_Nuriro_DD_Old_wagon_T2;
    1: set_Nuriro_DD_New_wagon_T2;
    2: set_Nuriro_DD_O_Train_wagon_T2;
    3: set_Nuriro_DD_ITX_Saemaeul_wagon_T2;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_DD_engineT_Front, cargo_subtype) {
    0: set_Nuriro_DD_Old_engineT;
    1: set_Nuriro_DD_New_engineT;
    2: set_Nuriro_DD_O_Train_engineT;
    3: set_Nuriro_DD_ITX_Saemaeul_engineT;
}

// 후진방향
switch(FEAT_TRAINS, SELF, sw_Nuriro_DD_engineH_Back, cargo_subtype) {
    0: set_Nuriro_DD_Old_engineH_Rev;
    1: set_Nuriro_DD_New_engineH_Rev;
    2: set_Nuriro_DD_O_Train_engineH_Rev;
    3: set_Nuriro_DD_ITX_Saemaeul_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_DD_engineT_Back, cargo_subtype) {
    0: set_Nuriro_DD_Old_engineT_Rev;
    1: set_Nuriro_DD_New_engineT_Rev;
    2: set_Nuriro_DD_O_Train_engineT_Rev;
    3: set_Nuriro_DD_ITX_Saemaeul_engineT_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_Nuriro_DD_engineH, train_is_driving_backwards) {
    0: sw_Nuriro_DD_engineH_Front;
    1: sw_Nuriro_DD_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_DD_engineT, train_is_driving_backwards) {
    0: sw_Nuriro_DD_engineT_Front;
    1: sw_Nuriro_DD_engineT_Back;
}

// 편성그래픽
// 4량
switch (FEAT_TRAINS, SELF, sw_Nuriro_DD_4car, position_in_vehid_chain % 4) {
    0: sw_Nuriro_DD_engineH; //default
    1: sw_Nuriro_DD_wagon_T1;
    2: sw_Nuriro_DD_wagon_T2;
    3: sw_Nuriro_DD_engineT;
    }

// 6량
switch (FEAT_TRAINS, SELF, sw_Nuriro_DD_6car, position_in_vehid_chain % 6) {
    0: sw_Nuriro_DD_engineH; //default
    1: sw_Nuriro_DD_wagon_T1;
    2..3: sw_Nuriro_DD_wagon_M;
    4: sw_Nuriro_DD_wagon_T2;
    5: sw_Nuriro_DD_engineT;
    }

// 8량
switch (FEAT_TRAINS, SELF, sw_Nuriro_DD_8car, position_in_vehid_chain % 8) {
    0: sw_Nuriro_DD_engineH; //default
    1: sw_Nuriro_DD_wagon_T1;
    2..5: sw_Nuriro_DD_wagon_M;
    6: sw_Nuriro_DD_wagon_T2;
    7: sw_Nuriro_DD_engineT;
    }

// 10량
switch (FEAT_TRAINS, SELF, sw_Nuriro_DD_10car, position_in_vehid_chain % 10) {
    0: sw_Nuriro_DD_engineH; //default
    1: sw_Nuriro_DD_wagon_T1;
    2..7: sw_Nuriro_DD_wagon_M;
    8: sw_Nuriro_DD_wagon_T2;
    9: sw_Nuriro_DD_engineT;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_Nuriro_DD_4car, extra_callback_info1) {
    1..3: Nuriro_DD_4Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_Nuriro_DD_6car, extra_callback_info1) {
    1..5: Nuriro_DD_6Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_Nuriro_DD_8car, extra_callback_info1) {
    1..7: Nuriro_DD_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_Nuriro_DD_10car, extra_callback_info1) {
    1..9: Nuriro_DD_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }