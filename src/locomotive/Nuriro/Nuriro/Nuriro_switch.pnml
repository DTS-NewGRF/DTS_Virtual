/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
//도색명
switch(FEAT_TRAINS, SELF, sw_Nuriro_cargo_subtype_text, cargo_subtype) {
    0: return string(STR_REFIT_LIVERY_Nuriro_Old); // 구도색
    1: return string(STR_REFIT_LIVERY_Nuriro_New); // 신도색
    2: return string(STR_REFIT_LIVERY_Nuriro_A);   // 한류관광
    3: return string(STR_REFIT_LIVERY_Nuriro_B);   // 순천향대
    4: return string(STR_REFIT_LIVERY_Nuriro_O);   // O-Train
    5: return string(STR_REFIT_LIVERY_Nuriro_DS);  // 동해산타
}

// 단량
switch(FEAT_TRAINS, SELF, sw_Nuriro_engineH, cargo_subtype) {
    0: set_Nuriro_Old_engineH;
    1: set_Nuriro_New_engineH;
    2: set_Nuriro_A_engineH;
    3: set_Nuriro_B_engineH;
    4: set_Nuriro_O_engineH;
    5: set_Nuriro_DS_engineH;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_panto_wagon, cargo_subtype) {
    0: set_Nuriro_Old_panto_wagon;
    1: set_Nuriro_New_panto_wagon;
    2: set_Nuriro_A_panto_wagon;
    3: set_Nuriro_B_panto_wagon;
    4: set_Nuriro_O_panto_wagon;
    5: set_Nuriro_DS_panto_wagon;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_wagon, cargo_subtype) {
    0: set_Nuriro_Old_wagon;
    1: set_Nuriro_New_wagon;
    2: set_Nuriro_A_wagon;
    3: set_Nuriro_B_wagon;
    4: set_Nuriro_O_wagon;
    5: set_Nuriro_DS_wagon;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_engineT, cargo_subtype) {
    0: set_Nuriro_Old_engineT;
    1: set_Nuriro_New_engineT;
    2: set_Nuriro_A_engineT;
    3: set_Nuriro_B_engineT;
    4: set_Nuriro_O_engineT;
    5: set_Nuriro_DS_engineT;
}

// 뒤집힘 단량
switch(FEAT_TRAINS, SELF, sw_Nuriro_engineH_r, cargo_subtype) {
    0: set_Nuriro_Old_engineH_r;
    1: set_Nuriro_New_engineH_r;
    2: set_Nuriro_A_engineH_r;
    3: set_Nuriro_B_engineH_r;
    4: set_Nuriro_O_engineH_r;
    5: set_Nuriro_DS_engineH_r;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_panto_wagon_r, cargo_subtype) {
    0: set_Nuriro_Old_panto_wagon_r;
    1: set_Nuriro_New_panto_wagon_r;
    2: set_Nuriro_A_panto_wagon_r;
    3: set_Nuriro_B_panto_wagon_r;
    4: set_Nuriro_O_panto_wagon_r;
    5: set_Nuriro_DS_panto_wagon_r;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_wagon_r, cargo_subtype) {
    0: set_Nuriro_Old_wagon_r;
    1: set_Nuriro_New_wagon_r;
    2: set_Nuriro_A_wagon_r;
    3: set_Nuriro_B_wagon_r;
    4: set_Nuriro_O_wagon_r;
    5: set_Nuriro_DS_wagon_r;
}

switch(FEAT_TRAINS, SELF, sw_Nuriro_engineT_r, cargo_subtype) {
    0: set_Nuriro_Old_engineT_r;
    1: set_Nuriro_New_engineT_r;
    2: set_Nuriro_A_engineT_r;
    3: set_Nuriro_B_engineT_r;
    4: set_Nuriro_O_engineT_r;
    5: set_Nuriro_DS_engineT_r;
}

// 편성그래픽
// 6량
switch (FEAT_TRAINS, SELF, sw_Nuriro_6Car, position_in_vehid_chain % 6) {
    1:sw_Nuriro_panto_wagon;
    2..3:sw_Nuriro_wagon;
    4:sw_Nuriro_panto_wagon;
    5:sw_Nuriro_engineT;
    sw_Nuriro_engineH; //default
    }

switch (FEAT_TRAINS, SELF, sw_Nuriro_6Car_r, position_in_vehid_chain % 6) {
    1:sw_Nuriro_panto_wagon_r;
    2..3:sw_Nuriro_wagon_r;
    4:sw_Nuriro_panto_wagon_r;
    5:sw_Nuriro_engineH_r;
    sw_Nuriro_engineT_r; //default
    }

switch(FEAT_TRAINS, SELF, sw_Nuriro_6Car_flipped, vehicle_is_flipped){
    0: sw_Nuriro_6Car_r;
    sw_Nuriro_6Car;
}

switch(FEAT_TRAINS, PARENT, sw_Nuriro_6Car_reversed, vehicle_is_reversed){
    0: sw_Nuriro_6Car;
    sw_Nuriro_6Car_flipped;
}

// 8량
switch (FEAT_TRAINS, SELF, sw_Nuriro_8Car, position_in_vehid_chain % 8) {
    1:sw_Nuriro_panto_wagon;
    2..5:sw_Nuriro_wagon;
    6:sw_Nuriro_panto_wagon;
    7:sw_Nuriro_engineT;
    sw_Nuriro_engineH; //default
    }

switch (FEAT_TRAINS, SELF, sw_Nuriro_8Car_r, position_in_vehid_chain % 8) {
    1:sw_Nuriro_panto_wagon_r;
    2..5:sw_Nuriro_wagon_r;
    6:sw_Nuriro_panto_wagon_r;
    7:sw_Nuriro_engineH_r;
    sw_Nuriro_engineT_r; //default
    }

switch(FEAT_TRAINS, SELF, sw_Nuriro_8Car_flipped, vehicle_is_flipped){
    0: sw_Nuriro_8Car_r;
    sw_Nuriro_8Car;
}

switch(FEAT_TRAINS, PARENT, sw_Nuriro_8Car_reversed, vehicle_is_reversed){
    0: sw_Nuriro_8Car;
    sw_Nuriro_8Car_flipped;
}

// 10량
switch (FEAT_TRAINS, SELF, sw_Nuriro_10Car, position_in_vehid_chain % 10) {
    1:sw_Nuriro_panto_wagon;
    2..7:sw_Nuriro_wagon;
    8:sw_Nuriro_panto_wagon;
    9:sw_Nuriro_engineT;
    sw_Nuriro_engineH; //default
    }

switch (FEAT_TRAINS, SELF, sw_Nuriro_10Car_r, position_in_vehid_chain % 10) {
    1:sw_Nuriro_panto_wagon_r;
    2..7:sw_Nuriro_wagon_r;
    8:sw_Nuriro_panto_wagon_r;
    9:sw_Nuriro_engineH_r;
    sw_Nuriro_engineT_r; //default
    }

switch(FEAT_TRAINS, SELF, sw_Nuriro_10Car_flipped, vehicle_is_flipped){
    0: sw_Nuriro_10Car_r;
    sw_Nuriro_10Car;
}

switch(FEAT_TRAINS, PARENT, sw_Nuriro_10Car_reversed, vehicle_is_reversed){
    0: sw_Nuriro_10Car;
    sw_Nuriro_10Car_flipped;
}

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_Nuriro_6Car, extra_callback_info1) {
    1..5: Nuriro_6Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_Nuriro_8Car, extra_callback_info1) {
    1..7: Nuriro_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_Nuriro_10Car, extra_callback_info1) {
    1..9: Nuriro_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }