/*--------------------------------------------------------------------
출발 기본사운드
적용열차
- 우진산전 수소연료전지동차
--------------------------------------------------------------------*/
switch(FEAT_TRAINS, SELF, sw_Nostart_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/osfx_10.wav");
    SOUND_EVENT_LOAD_UNLOAD: sound("sounds/osfx_20.wav");
    return CB_RESULT_NO_SOUND;
    }

