/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_Nextrain_1000_engineH, train_is_driving_backwards) {
    0: set_Nextrain_1000_engineH;
    1: set_Nextrain_1000_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_Nextrain_1000_engineT, train_is_driving_backwards) {
    0: set_Nextrain_1000_engineT;
    1: set_Nextrain_1000_engineT_Rev;
}

// 편성그래픽
// 3량
switch (FEAT_TRAINS, SELF, sw_Nextrain_1000_3car, position_in_vehid_chain % 3) {
    0: sw_Nextrain_1000_engineH; //default
    1: set_Nextrain_1000_wagon;
    2: sw_Nextrain_1000_engineT;
    }

// 4량
switch (FEAT_TRAINS, SELF, sw_Nextrain_1000_4car, position_in_vehid_chain % 4) {
    0: sw_Nextrain_1000_engineH; //default
    1: set_Nextrain_1000_wagon;
    2: set_Nextrain_1000_wagon;
    3: sw_Nextrain_1000_engineT;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_Nextrain_1000_3car, extra_callback_info1) {
    1..2: Nextrain_3Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_Nextrain_1000_4car, extra_callback_info1) {
    1..3: Nextrain_4Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }